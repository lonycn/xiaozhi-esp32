{
    "manufacturer": "spotpear",
    "type": "sp-esp32-s3-1.28-box",
    "target": "esp32s3",
    "builds": [
        {
            "name": "sp-esp32-s3-1.28-box",
            "sdkconfig_append": []
        },
        {
            "name": "sp-esp32-s3-1.28-box-ai-lan",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_MODE_QUAD=n",
                "CONFIG_XIAOZHI_USB_SCREEN_MIRROR=n",
                "CONFIG_XIAOZHI_USB_TEXT_CHAT=n",
                "CONFIG_XIAOZHI_DEVELOPMENT_IDENTITY=n",
                "CONFIG_XIAOZHI_AUDIO_DIAGNOSTICS=n",
                "CONFIG_XIAOZHI_ALLOW_AUTOMATIC_FIRMWARE_UPGRADE=y",
                "CONFIG_XIAOZHI_REQUIRE_RELEASE_MANIFEST=y",
                "CONFIG_XIAOZHI_REQUIRE_TTS_TURN_TAGS=y",
                "CONFIG_XIAOZHI_CONTROLLED_RELEASE=y",
                "CONFIG_XIAOZHI_RELEASE_ALLOW_LAN_HTTP=y",
                "CONFIG_OTA_URL=\"http://192.168.3.66:19183/xiaozhi/ota/\"",
                "CONFIG_USE_ESP_WAKE_WORD=n",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_WAKE_WORD_DISABLED=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_SR_MN_CN_NONE=n",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"da leng zong guan\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"大冷总管\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_CUSTOM_WAKE_WORD_ALIASES=\"ni hao zong guan;zong guan zong guan\""
            ]
        }
    ]
}
